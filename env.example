NEXT_PUBLIC_SITE_URL=http://localhost:3000

# UPI Payment Configuration
# ⚠️ CRITICAL: Replace with YOUR real UPI ID for testing
# Invalid UPI ID will cause "Cannot pay with this QR code" error
# 
# How to get your UPI ID:
# - PhonePe: Profile → My UPI ID (format: yourname@ybl)
# - Google Pay: Settings → UPI IDs (format: mobile@okaxis)  
# - Paytm: Profile → UPI ID (format: mobile@paytm)
#
# For TESTING use your own UPI ID:
NEXT_PUBLIC_UPI_ID=8409725206@kotak811
NEXT_PUBLIC_UPI_RECIPIENT_NAME=Bhaskar Kumar
