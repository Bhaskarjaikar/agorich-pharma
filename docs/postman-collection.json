{
  "info": {
    "name": "Agorich Pharma API",
    "description": "Comprehensive API collection for Agorich Pharma's hyperlocal pharma intelligence operating system.\n\n## Overview\nThis collection contains all API endpoints organized by functionality:\n- **Agent Connect**: AI agent integration endpoints\n- **Command Center**: AI-powered command center\n- **Admin**: Administrative endpoints\n- **Approvals**: Approval workflow management\n- **Webhooks**: Webhook handlers\n- **Metrics**: Real-time metrics\n- **Invoices**: Invoice management\n- **Intelligence**: AI business intelligence\n\n## Authentication\n- Agent API Key: Use `x-agent-api-key` header\n- Admin API Key: Use `x-admin-api-key` header\n- User Auth: Use Bearer token from Supabase Auth\n\n## Rate Limits\n- General: 100 requests/minute\n- AI Endpoints: 20 requests/minute\n- Webhooks: 200 requests/minute",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "agentApiKey",
      "value": "your-agent-api-key",
      "type": "string"
    },
    {
      "key": "adminApiKey",
      "value": "your-admin-api-key",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "your-jwt-token",
      "type": "string"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-agent-api-key",
        "in": "header"
      }
    ]
  },
  "item": [
